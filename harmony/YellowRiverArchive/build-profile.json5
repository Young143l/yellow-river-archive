{
  app: {
    // 签名不在此处配置：hvigor 要求密码是 DevEco 加密后的 32 位密文，
    // 命令行无法生成。改为构建出 unsigned HAP 后由
    // tools/sign-openharmony.sh 用 SDK 自带的 hap-sign-tool 签名。
    signingConfigs: [],
    products: [
      {
        name: 'default',
        compileSdkVersion: '26.0.0',
        compatibleSdkVersion: '26.0.0',
        targetSdkVersion: '26.0.0',
        runtimeOS: 'OpenHarmony',
        buildOption: {
          strictMode: {
            caseSensitiveCheck: true,
            useNormalizedOHMUrl: true,
          },
        },
      },
    ],
    buildModeSet: [
      {
        name: 'debug',
      },
      {
        name: 'release',
      },
    ],
  },
  modules: [
    {
      name: 'entry',
      srcPath: './entry',
      targets: [
        {
          name: 'default',
          applyToProducts: [
            'default',
          ],
        },
      ],
    },
  ],
}
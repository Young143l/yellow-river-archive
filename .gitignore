# 流水线缓存与派生数据（体积大，可由源重建）
packages/data/.cache/
packages/data/derived/

# AI 草稿（生成物，禁止直接入库；正式内容在 sites/，草稿应经改写后移入）
packages/data/drafts/
packages/data/assets/img/**/thumb/

# 环境与密钥（严禁入库）
.env
.env.local
.env.*.local
*.pem
*.p12
*.p7b
*.cer
*.csr

# Office 锁文件
.~*.xlsx
.~*.docx
.~*.pptx
~$*.xlsx
~$*.docx
~$*.pptx

# 编辑器与系统
.DS_Store
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*.swo

# 日志
*.log
logs/

# 真机验证截图（本地留存，用于设计方案 docx 的测试记录，不入版本库）
.shots/

# 测试与覆盖率
coverage/

# 服务端运行数据（SQLite 与个人数据存储）
apps/server/data/
